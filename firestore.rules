rules_version = '2';
// =====================================================================
// ShopSathi v1.1.2 — Firestore Security Rules
// v1.1.1: free plan nahi; nayi dukaan 'pending' (admin approve ya activation code se chalu);
//         licenses (activation codes); naye customer ki manzoori (approveJoin)
// Firebase Console > Firestore Database > Rules > ye poora text paste > Publish
// ZAROORI: neeche adminMobiles() mein apna (Super Admin) mobile number daalein
// (shared/config.js ke adminMobile jaisa hi).
// Login email ka format: <mobile>@shopsathi.app  (app khud banata hai)
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Super Admin ka mobile (10 digit) ----
    function adminMobiles() { return ['9765838383']; }

    function signedIn() { return request.auth != null; }
    function myMobile() { return request.auth.token.email.split('@')[0]; }
    function isAdmin() { return signedIn() && myMobile() in adminMobiles(); }
    function shopDoc(shopId) { return /databases/$(database)/documents/shops/$(shopId); }
    function memberDoc(shopId, mobile) { return /databases/$(database)/documents/shops/$(shopId)/members/$(mobile); }
    function shopData(shopId) { return get(shopDoc(shopId)).data; }
    function isOwner(shopId) { return signedIn() && shopData(shopId).ownerUid == request.auth.uid; }
    function isStaff(shopId) { return signedIn() && request.auth.uid in shopData(shopId).staffUids; }
    function isManager(shopId) { return isOwner(shopId) || isStaff(shopId); }
    function isMe(mobile) { return signedIn() && myMobile() == mobile; }
    function licDoc(code) { return /databases/$(database)/documents/licenses/$(code); }
    // dukaan chalu = admin ne band nahi ki + plan ki tareekh baaki hai
    function shopActive(shopId) {
      return shopData(shopId).active == true && shopData(shopId).paidUntil > request.time.toMillis();
    }
    function myMemberOk(shopId) {
      return exists(memberDoc(shopId, myMobile()))
        && get(memberDoc(shopId, myMobile())).data.blocked == false
        && get(memberDoc(shopId, myMobile())).data.get('pending', false) == false;
    }

    // ---- activation codes (Super Admin banata hai, malik ek baar use karta hai) ----
    match /licenses/{code} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.used == false
            && request.resource.data.used == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt', 'usedByName'])
            && get(shopDoc(request.resource.data.usedBy)).data.ownerUid == request.auth.uid
            && getAfter(shopDoc(request.resource.data.usedBy)).data.licenseCode == code);
    }

    // ---- har user ka apna profile ----
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- dukaan ----
    match /shops/{shopId} {
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.plan == 'pending'
        && request.resource.data.paidUntil == 0
        && request.resource.data.active == false
        && request.resource.data.customerCount == 0
        && request.resource.data.nextCode == 1
        && request.resource.data.staffUids.size() == 0;

      // customer judne / hatne par sirf counter (nextCode, customerCount) badalta hai
      function counterChange() {
        let d = request.resource.data.diff(resource.data);
        let joinMe = existsAfter(memberDoc(shopId, myMobile())) && !exists(memberDoc(shopId, myMobile()));
        let leaveMe = !existsAfter(memberDoc(shopId, myMobile())) && exists(memberDoc(shopId, myMobile()));
        return d.affectedKeys().hasOnly(['nextCode', 'customerCount'])
          && (
            (request.resource.data.nextCode == resource.data.nextCode + 1
              && request.resource.data.customerCount == resource.data.customerCount + 1
              && resource.data.active == true
              && resource.data.paidUntil > request.time.toMillis()
              && (isManager(shopId) || joinMe))
            ||
            (request.resource.data.nextCode == resource.data.nextCode
              && request.resource.data.customerCount == resource.data.customerCount - 1
              && (isManager(shopId) || leaveMe))
          );
      }

      // activation code se dukaan chalu / plan badhana (sirf malik, code ek hi baar)
      function redeem() {
        let lic = request.resource.data.licenseCode;
        let days = get(licDoc(lic)).data.days;
        return resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'paidUntil', 'active', 'licenseCode', 'licensedAt'])
          && (resource.data.active == true || resource.data.plan == 'pending')
          && request.resource.data.plan == 'paid'
          && request.resource.data.active == true
          && get(licDoc(lic)).data.used == false
          && getAfter(licDoc(lic)).data.used == true
          && getAfter(licDoc(lic)).data.usedBy == shopId
          && (request.resource.data.paidUntil <= resource.data.paidUntil + days * 86400000
              || request.resource.data.paidUntil <= request.time.toMillis() + days * 86400000 + 600000);
      }

      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                 ['ownerUid', 'plan', 'paidUntil', 'active', 'createdAt', 'customerCount', 'nextCode', 'shortCode', 'licenseCode', 'licensedAt']))
        || (signedIn() && counterChange())
        || (signedIn() && redeem())
        // fresh start: malik saare customers hatane ke baad ginti 0 aur code 1 se
        || (signedIn() && resource.data.ownerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerCount', 'nextCode', 'freshAt'])
            && request.resource.data.customerCount == 0
            && request.resource.data.nextCode == 1);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // ---- customers (doc id = mobile) ----
      match /members/{mobile} {
        allow read: if isMe(mobile) || isManager(shopId) || isAdmin();
        allow create: if (isManager(shopId) && shopActive(shopId))
          || (isMe(mobile) && shopActive(shopId)
              && request.resource.data.get('pending', false) == shopData(shopId).get('approveJoin', false)
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.points == shopData(shopId).welcomeBonus
              && request.resource.data.lifetimePoints == shopData(shopId).welcomeBonus
              && request.resource.data.totalSpend == 0
              && request.resource.data.billCount == 0
              && request.resource.data.blocked == false
              && request.resource.data.level == 'silver'
              && request.resource.data.referralPaid == false);
        allow update: if isManager(shopId)
          || (isMe(mobile)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'appUser', 'name', 'dobMonth'])
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dobMonth'])
                  || resource.data.get('dobMonth', 0) == 0));
        allow delete: if isOwner(shopId) || isMe(mobile);

        match /notifs/{nid} {
          allow read, delete: if isMe(mobile) || isManager(shopId);
          allow create: if isManager(shopId);
          allow update: if isManager(shopId)
            || (isMe(mobile) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
        }
      }

      // ---- bills ----
      match /bills/{billId} {
        allow read: if isManager(shopId) || isAdmin()
          || (signedIn() && resource.data.memberId == myMobile());
        allow create: if (isManager(shopId) && shopActive(shopId))
          || (signedIn()
              && request.resource.data.memberId == myMobile()
              && request.resource.data.status == 'pending'
              && request.resource.data.points == 0
              && request.resource.data.amount is number
              && request.resource.data.amount > 0
              && shopActive(shopId)
              && myMemberOk(shopId));
        allow update: if isManager(shopId)
          && (shopActive(shopId)
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasPhoto', 'photoArchived']));
        allow delete: if isOwner(shopId)
          || (signedIn() && resource.data.memberId == myMobile());
      }

      // ---- bill photos (alag doc taaki list halki rahe) ----
      match /photos/{billId} {
        allow read: if isManager(shopId)
          || (signedIn() && resource.data.memberId == myMobile());
        allow create: if isManager(shopId)
          || (signedIn() && request.resource.data.memberId == myMobile()
              && request.resource.data.data.size() < 400000);
        allow update: if false;
        allow delete: if isOwner(shopId)
          || (signedIn() && resource.data.memberId == myMobile());
      }

      // ---- gifts ----
      match /gifts/{giftId} {
        allow read: if signedIn();
        allow create, delete: if isOwner(shopId);
        allow update: if isOwner(shopId)
          || (isStaff(shopId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
      }

      // ---- gift requests ----
      match /redemptions/{rid} {
        allow read: if isManager(shopId)
          || (signedIn() && resource.data.memberId == myMobile());
        allow create: if signedIn()
          && request.resource.data.memberId == myMobile()
          && request.resource.data.status == 'requested'
          && myMemberOk(shopId);
        allow update: if isManager(shopId)
          || (signedIn() && resource.data.memberId == myMobile()
              && resource.data.status == 'requested'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt']));
        allow delete: if isOwner(shopId)
          || (signedIn() && resource.data.memberId == myMobile());
      }

      // ---- points ledger (hisaab) ----
      match /ledger/{lid} {
        allow read: if isManager(shopId)
          || (signedIn() && resource.data.memberId == myMobile());
        allow create: if isManager(shopId)
          || (signedIn()
              && request.resource.data.memberId == myMobile()
              && request.resource.data.type == 'welcome'
              && request.resource.data.points == shopData(shopId).welcomeBonus);
        allow update: if false;
        allow delete: if isOwner(shopId)
          || (signedIn() && resource.data.memberId == myMobile());
      }
    }
  }
}
